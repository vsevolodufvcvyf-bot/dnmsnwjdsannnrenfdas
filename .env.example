# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй и не выкладывай.
# golden_key FunPay и токен Telegram-бота хранятся в configs/_main.cfg, а не здесь.

# Твой числовой Telegram ID (узнать у @userinfobot).
# Только владелец может выводить деньги, делать возвраты и добавлять операторов.
TELEGRAM_OWNER_ID=

# Операторы: числовые Telegram ID через запятую. Ники (@username) доступ больше не дают.
TELEGRAM_OPERATORS=

# Ключи нейросетей для ИИ-консультанта (необязательно).
OPENROUTER_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
